# Neon Postgres. Both are needed:
#   DATABASE_URL — pooled connection (host contains "-pooler"), used at runtime.
#   DIRECT_URL   — unpooled connection, used by Prisma Migrate, which cannot
#                  run through a connection pooler.
# The same two values go into Vercel's environment variables when deploying.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/timetrack?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/timetrack?sslmode=require"

# Supabase Auth only — data stays in Neon above. From your Supabase project's
# Settings > API page. Both are safe to expose to the browser (NEXT_PUBLIC_*):
# the anon key is rate-limited and authorization is enforced server-side via
# getCurrentUserId(), not by these keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Stripe billing (€9.90/month paywall — see "Billing" in CLAUDE.md).
#   STRIPE_SECRET_KEY     — Developers > API keys (sk_test_... in test mode). Secret.
#   STRIPE_WEBHOOK_SECRET — signing secret of the webhook endpoint pointed at
#                           /api/stripe/webhook (or printed by `stripe listen`). Secret.
#   NEXT_PUBLIC_STRIPE_PAYMENT_LINK — the €9.90/month Payment Link's URL.
#   PAYWALL_EXEMPT_EMAILS — comma-separated emails that never see the paywall.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PAYMENT_LINK="https://buy.stripe.com/test_..."
PAYWALL_EXEMPT_EMAILS="owner@example.com"
